# ~/.config/i3/config - ambiente so-terminal, fullscreen sobre RDP.
# $mod = tecla Windows (o mstsc em fullscreen entrega ela para o Linux).

set $mod Mod4

font pango:DejaVu Sans Mono 11

# O layout do teclado nao vem do Windows: a sessao precisa declarar o dela.
exec --no-startup-id setxkbmap -model abnt2 -layout br

# Janelas empilhadas (flutuantes), como no GNOME - nao em tiling.
default_border none
hide_edge_borders both
focus_follows_mouse no

# ---------------------------------------------------------------------------
# Comportamento flutuante
#
# Por padrao o i3 e um WM de tiling: ele calcula a posicao das janelas e nao
# deixa arrastar nada com o mouse. A linha abaixo inverte isso - toda janela
# nasce flutuante, livre para mover e sobrepor, como num desktop comum.
#
# A borda das flutuantes precisa deixar de ser "none": e a barra de titulo que
# da onde pegar com o mouse. Sem ela a janela existe mas nao ha o que arrastar.
# ---------------------------------------------------------------------------
for_window [class=".*"] floating enable
default_floating_border normal 2

# Arrastar: $mod + botao esquerdo. Redimensionar: $mod + botao direito.
# (sem isto o modificador de arrasto seria o Alt, que conflita com apps.)
floating_modifier $mod

# $mod+space alterna uma janela entre flutuante e encaixada, caso queira
# tiling pontualmente numa ou noutra.

# ---------------------------------------------------------------------------
# Terminais
#
# O que mantem a janela DENTRO desta sessao e o GDK_BACKEND=x11 exportado no
# /etc/xrdp/startwm.sh - nao esta flag. Veja o comentario longo la.
#
# --disable-server fica como seguro extra: impede que uma instancia que ja
# esteja rodando em outro display seja quem abre a aba.
# ---------------------------------------------------------------------------
set $term xfce4-terminal --disable-server

bindsym $mod+Return    exec --no-startup-id $term
bindsym Control+Mod1+t exec --no-startup-id $term
bindsym $mod+Shift+q kill
bindsym $mod+d exec --no-startup-id dmenu_run

# Abre um terminal assim que a sessao sobe.
exec --no-startup-id $term

# ---------------------------------------------------------------------------
# Foco e movimento (setas ou hjkl)
# ---------------------------------------------------------------------------
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# ---------------------------------------------------------------------------
# Divisao / layout
# ---------------------------------------------------------------------------
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+e layout toggle split
bindsym $mod+w layout tabbed
bindsym $mod+s layout stacking
bindsym $mod+space floating toggle

# Redimensionar: $mod+r, depois setas, Esc para sair.
mode "resize" {
    bindsym Left  resize shrink width  5 px or 5 ppt
    bindsym Down  resize grow   height 5 px or 5 ppt
    bindsym Up    resize shrink height 5 px or 5 ppt
    bindsym Right resize grow   width  5 px or 5 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ---------------------------------------------------------------------------
# Workspaces
# ---------------------------------------------------------------------------
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9

# ---------------------------------------------------------------------------
# Multi-monitor
#
# Cada monitor entregue pelo /multimon do RDP vira uma saida RandR. O i3
# descobre sozinho quantas sao e distribui os workspaces entre elas, entao nao
# ha nada fixo aqui - trocar de monitor nao quebra a config.
# ---------------------------------------------------------------------------
bindsym $mod+Control+Left  focus output left
bindsym $mod+Control+Right focus output right

bindsym $mod+Control+Shift+Left  move workspace to output left
bindsym $mod+Control+Shift+Right move workspace to output right

# Move so a janela focada para o outro monitor (o workspace fica onde esta).
# No i3 nao se arrasta janela com o mouse: o layout e calculado, e cada
# workspace pertence a um monitor. $mod+Shift+setas move a janela DENTRO do
# workspace e para na borda - atravessar para a outra tela e este comando.
bindsym $mod+Mod1+Left  move container to output left
bindsym $mod+Mod1+Right move container to output right

# ---------------------------------------------------------------------------
# Sessao
# ---------------------------------------------------------------------------
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec --no-startup-id "i3-msg exit"

# ---------------------------------------------------------------------------
# Barra: desativada de proposito (o pedido era "so terminal").
# Se um dia quiser ver em que workspace esta + relogio, descomente o bloco.
# ---------------------------------------------------------------------------
# bar {
#     status_command i3status
#     position top
#     mode dock
#     tray_output none
# }
