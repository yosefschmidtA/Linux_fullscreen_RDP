[Desktop Entry]
Type=Application
Version=1.0
Name=Sair da sessao
Name[pt_BR]=Sair da sessao
GenericName=Encerrar a sessao grafica
Comment=Encerra a sessao grafica; a VM continua ligada
Comment[pt_BR]=Encerra a sessao grafica; a VM continua ligada
