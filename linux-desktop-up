#!/bin/sh
# Chamado pelo atalho do Windows antes de abrir o mstsc: acorda a WSL,
# garante o /tmp/.X11-unix gravavel e poe o xrdp no ar.
set -e

/usr/local/bin/fix-x11-unix

systemctl is-active --quiet xrdp-sesman || systemctl start xrdp-sesman
systemctl is-active --quiet xrdp        || systemctl start xrdp
